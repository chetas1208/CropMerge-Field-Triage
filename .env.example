# Nuxt product API
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NUXT_PUBLIC_APP_NAME=CropMerge Field Triage

# Internal vision engine (Python FastAPI)
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_TIMEOUT_MS=600000

# Shared storage (relative to monorepo root)
DATA_DIR=./data
OUTPUTS_DIR=./outputs
UPLOADS_DIR=./data/uploads

# ── Local databases ──────────────────────────────────────────
# Default: SQLite files (run: bash scripts/init-local-dbs.sh)
DATABASE_DIR=./data/db
DATABASE_URL=sqlite:///./data/db/cropmerge.sqlite
NUXT_DATABASE_URL=sqlite:///./data/db/cropmerge.sqlite
VISION_DATABASE_URL=sqlite:///./data/db/vision.sqlite

# Optional Postgres (docker compose up -d postgres)
# DATABASE_URL=postgresql://cropmerge:cropmerge@127.0.0.1:5432/cropmerge
# VISION_DATABASE_URL=postgresql://cropmerge:cropmerge@127.0.0.1:5432/cropmerge_vision

# Vision runtime + weights (see apps/vision/models/weights.env)
CROP_MERGE_DEVICE=auto
CROP_MERGE_SEGMENTATION_BACKEND=heuristic
CROP_MERGE_DINO_BACKEND=heuristic
# After download_weights.py:
#   set -a; source apps/vision/models/weights.env; set +a
# CROP_MERGE_SEGMENTATION_BACKEND=sam2
# SAM2_CHECKPOINT=./apps/vision/models/sam2.1_hiera_small.pt
# CROP_MERGE_DINO_BACKEND=dinov2
# DINOV2_CHECKPOINT=./apps/vision/models/dinov2_vitb14_pretrain.pth
# Gated (HF_TOKEN + license):
# CROP_MERGE_SEGMENTATION_BACKEND=sam3
# SAM3_CHECKPOINT=
# CROP_MERGE_DINO_BACKEND=dinov3
# DINOV3_CHECKPOINT=
